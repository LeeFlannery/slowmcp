{
  "name": "slowmcp-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter slowmcp build",
    "test": "vitest run",
    "typecheck": "pnpm --filter slowmcp typecheck && tsc --project spikes/tsconfig.json",
    "spike:mcp": "node --experimental-strip-types spikes/src/raw-sdk-spike.ts",
    "spike:baseline": "node --experimental-strip-types spikes/src/baseline-spike.ts",
    "slowmcp:check": "node scripts/slowmcp-check.mjs",
    "eval:export-surface": "node scripts/verify-export-surface.mjs packages/slowmcp",
    "ref:hello": "pnpm --filter @slowmcp-examples/hello-tool verify"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
