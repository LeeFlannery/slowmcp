{
  "name": "slowmcp",
  "version": "0.1.0-slice.1",
  "private": true,
  "description": "Blazingly adequate. A framework for building, testing, and shipping MCP servers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./types/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./protocol": {
      "types": "./types/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "node ../../scripts/build-coffee.mjs",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "coffeescript": "2.7.0",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0"
  }
}
